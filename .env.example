# ── OpenRouter LLM ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── HuggingFace (optional — higher rate limits for embedding model downloads) ─
HUGGINGFACE_TOKEN=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_PATH=./chroma_data
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── MCP Server ───────────────────────────────────────────────────────────────
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# ── FastAPI Dashboard ─────────────────────────────────────────────────────────
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1

# ── Google OAuth (Gmail) ─────────────────────────────────────────
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CREDENTIALS_PATH=./secrets/credentials.json
GOOGLE_TOKEN_PATH=./secrets/token.json

# ── Twilio (optional critical deadline calls) ───────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# ── Observer ─────────────────────────────────────────────────────────────────
OBSERVER_POLL_INTERVAL=60

# Quiet hours apply in this time zone. Set both times equal to disable quiet hours.
DEADLINE_TIMEZONE=UTC
DEADLINE_QUIET_START=22:00
DEADLINE_QUIET_END=07:00
DEADLINE_REMINDER_INTERVAL=15
DEADLINE_HOURLY_LIMIT=5
# Enable automatic calls for critical Gmail deadlines when Twilio is configured.
DEADLINE_PHONE_ENABLED=false
DEADLINE_PHONE_DAILY_LIMIT=2
